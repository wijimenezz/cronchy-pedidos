# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca subas secretos al repo.

# ------------------------------------------------------------
# Base de datos (Supabase)
# ------------------------------------------------------------
# Runtime: transaction pooler, puerto 6543. Se usa con postgres(url, { prepare: false }).
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Migraciones e introspect (drizzle-kit): session pooler, puerto 5432.
# La conexión directa (db.PROYECTO.supabase.co) NO sirve: es IPv6.
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------
# Tienda
# ------------------------------------------------------------
# Slug de la fila de `store` que sirve esta instancia. getStore() lo resuelve una sola vez.
STORE_SLUG="cronchy"

# URL pública. Su ÚNICO uso es el link de seguimiento que viaja por WhatsApp al cliente, y de
# ahí sale todo lo demás: quien lo va a tocar está en la calle esperando sus churros, así que
# `localhost` no sirve NI SIQUIERA EN DESARROLLO. Ponla apuntando al dominio de verdad también
# en local: tu panel y el desplegado comparten base de datos, así que un pedido aceptado desde
# `pnpm dev` le manda a un cliente real el link que diga esta variable.
#
# En Vercel lo mejor es NO DEFINIRLA: se deduce sola del dominio del despliegue, y así no puede
# quedarse apuntando a un host viejo el día que cambies de dominio. Si aun así queda puesta en
# localhost, `resolverBaseUrl()` la ignora estando desplegado — pero no lo conviertas en el plan.
NEXT_PUBLIC_BASE_URL="https://cronchy-pedidos.vercel.app"

# ------------------------------------------------------------
# Panel — sesión
# ------------------------------------------------------------
# Firma la cookie de sesión del panel (HMAC-SHA256). Mínimo 32 caracteres.
# Genérala con: openssl rand -base64 32
# Cambiarla cierra la sesión de todo el mundo, que es justo lo que se quiere si se filtra.
AUTH_SECRET=""

# ------------------------------------------------------------
# Supabase Storage
# ------------------------------------------------------------
# SOLO SERVIDOR. La service role key salta cualquier restricción de la base:
# jamás la prefijes con NEXT_PUBLIC_ ni la importes desde un componente del navegador.
#
# Hacen falta DOS buckets, y la diferencia entre ellos no es un detalle:
#
#   "comprobantes" — PRIVADO. Guarda datos personales (capturas de pago de Nequi) y se
#                    lee por el proxy autenticado del panel. Se purga a los 60 días.
#   "productos"    — PÚBLICO. Fotos de la carta y banners de categoría: los ve cualquiera
#                    sin sesión, así que servirlas por un proxy no tendría sentido.
#
# Si "productos" no existe, la subida de fotos del panel responde 400.
#
# La llave vale en los dos formatos: la nueva `sb_secret_…` o la `service_role` clásica
# (un JWT largo que empieza por `eyJ…`). El código manda las cabeceras `Authorization` y
# `apikey` a la vez porque la nueva NO es un JWT: con solo `Authorization`, Storage
# responde `400 Invalid Compact JWS` y no menciona en ningún lado la cabecera que falta.
SUPABASE_URL="https://PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------
# Mensajería (opcional)
# ------------------------------------------------------------
# "link" (por defecto) arma URLs wa.me que se abren con un toque.
# "api" exige la Cloud API de Meta con un número dedicado — ver regla 10 de CLAUDE.md.
WHATSAPP_MODO="link"

# ------------------------------------------------------------
# Avisos al panel (Web Push)
# ------------------------------------------------------------
# El único canal que avisa de un pedido con el navegador cerrado. Genera el par una sola vez:
#
#   npx web-push generate-vapid-keys
#
# ESTE `NEXT_PUBLIC_` SÍ VA, al revés que la llave `anon` de Supabase, y conviene saber por qué:
# la llave pública VAPID está DISEÑADA para viajar al navegador. Es la que identifica al servidor
# ante el servicio de push, y sola no autoriza absolutamente nada.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# La privada firma cada envío. Solo servidor, como cualquier secreto.
VAPID_PRIVATE_KEY=""

# Contacto que exige el estándar por si un servicio de push necesita reportar un problema.
VAPID_SUBJECT="mailto:hola@cronchy.co"

# ------------------------------------------------------------
# Avisos al equipo (Telegram)
# ------------------------------------------------------------
# El aviso que CUENTA el pedido: llega al teléfono de cualquiera del equipo con el detalle
# completo y un botón al panel. Es canal de salida y nada más — el bot no lee ni contesta.
#
# Si faltan estas dos, el aviso simplemente no sale (el pedido se crea igual y el panel lo tiene).
# Compruébalas con: pnpm verificar-telegram
#
# El token lo da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=""

# A dónde llega. Puede ser un chat personal o un grupo del equipo — en un grupo, el id es
# NEGATIVO y hay que meter al bot dentro.
#
# Para sacarlo: escríbele algo al bot (o mándalo al grupo) y abre
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# El número está en `message.chat.id`.
#
# Ojo con lo que se manda ahí: el mensaje lleva nombre, teléfono y dirección del cliente, así que
# el chat es tan privado como el panel. Las dos primeras líneas —lo único que se ve en una
# pantalla bloqueada— no llevan ningún dato personal, a propósito.
TELEGRAM_CHAT_ID=""
