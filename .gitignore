# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
private

# graphify
/graphify-out/

# Aquí decía `public` a secas, y eso ignoraba la carpeta ENTERA del sitio. No se notaba porque los
# archivos que ya estaban siguen rastreados; lo que desaparecía en silencio era todo lo que se
# añadiera después —los iconos de la app, sin ir más lejos—, que funciona en local y da 404 en
# producción. Si algún día hay que excluir algo de `public/`, que sea esa ruta y no la carpeta.
